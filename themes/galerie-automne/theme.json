{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:franckobe/mytv-themes:galerie-automne",
  "title": "Galerie d'automne",
  "description": "Une forêt d'automne canadienne dans la brume, en photo. Esprit galerie : tuiles encadrées quasi invisibles qui flottent, micro-libellés en capitales espacées, grand calme.",
  "author": {
    "name": "Franck",
    "url": "https://github.com/franckobe"
  },
  "themeVersion": "2.0.0",
  "layout": {
    "preset": "dock-grid",
    "columns": 6,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1,
    "allowColumnOverride": false
  },
  "defaults": {
    "wallpaperAssetId": "landscape",
    "dim": 0.22,
    "accent": "#e9d9bf"
  },
  "assets": [
    {
      "id": "preview",
      "path": "assets/preview.jpg",
      "mediaType": "image/jpeg",
      "width": 960,
      "height": 540
    },
    {
      "id": "landscape",
      "path": "assets/landscape.jpg",
      "mediaType": "image/jpeg",
      "width": 1920,
      "height": 1080
    }
  ],
  "previewAssetId": "preview",
  "license": {
    "identifier": "MIT",
    "textPath": "LICENSE.txt",
    "creditsPath": "CREDITS.txt"
  }
}
