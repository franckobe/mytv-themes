{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:franckobe/mytv-noel-theme:noel-neige",
  "title": "Noël sous la neige",
  "description": "Un soir d'hiver enneigé en fond animé, tuiles en verre translucide et accents dorés chaleureux. Horloge claire, neige qui tombe.",
  "author": {
    "name": "Franck",
    "url": "https://github.com/franckobe"
  },
  "themeVersion": "1.0.0",
  "layout": {
    "preset": "scenic-grid",
    "columns": 8,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1,
    "allowColumnOverride": false
  },
  "defaults": {
    "wallpaperAssetId": "landscape",
    "dim": 0.45,
    "accent": "#f0c070"
  },
  "assets": [
    {
      "id": "preview",
      "path": "assets/preview.jpg",
      "mediaType": "image/jpeg",
      "width": 960,
      "height": 540
    },
    {
      "id": "landscape",
      "path": "assets/landscape.jpg",
      "mediaType": "image/jpeg",
      "width": 1920,
      "height": 1080
    }
  ],
  "previewAssetId": "preview",
  "license": {
    "identifier": "MIT",
    "textPath": "LICENSE.txt",
    "creditsPath": "CREDITS.txt"
  },
  "wallpaperVideo": {
    "variants": [
      {
        "quality": "1080p",
        "path": "assets/wallpaper-1080p.mp4"
      }
    ]
  }
}
