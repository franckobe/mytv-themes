{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:franckobe/mytv-noel-theme:noel-neige",
  "title": "Automne au bord du lac",
  "description": "Un lac de montagne en miroir aux couleurs d'automne, en fond animé. Tuiles en verre translucide, accents ambrés chaleureux et horloge claire.",
  "author": {
    "name": "Franck",
    "url": "https://github.com/franckobe"
  },
  "themeVersion": "1.2.0",
  "layout": {
    "preset": "dock-grid",
    "columns": 6,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1,
    "allowColumnOverride": false,
    "motion": "classic"
  },
  "defaults": {
    "wallpaperAssetId": "landscape",
    "dim": 0.5,
    "accent": "#e0943c"
  },
  "assets": [
    {
      "id": "preview",
      "path": "assets/preview.jpg",
      "mediaType": "image/jpeg",
      "width": 960,
      "height": 540
    },
    {
      "id": "landscape",
      "path": "assets/landscape.jpg",
      "mediaType": "image/jpeg",
      "width": 1920,
      "height": 1080
    }
  ],
  "previewAssetId": "preview",
  "license": {
    "identifier": "MIT",
    "textPath": "LICENSE.txt",
    "creditsPath": "CREDITS.txt"
  },
  "wallpaperVideo": {
    "variants": [
      {
        "quality": "1080p",
        "path": "assets/wallpaper-1080p.mp4"
      }
    ]
  }
}
